@if (_identity.HasValue)
{
    @ChildContent(_identity.Value)
}
else{
    @NotFoundTemplate
}

@code {
    ulong? _identity;

    protected override void OnParametersSet()
    {
        _identity = ulong.TryParse(Input, out var identity) ? identity : null;
        base.OnParametersSet();
    }


    [Parameter]
    public required string Input { get; set; }

    [Parameter]
    public RenderFragment<ulong> ChildContent { get; set; } = null!;

    [Parameter]
    public RenderFragment NotFoundTemplate { get; set; } = @<div>The identity could not be determined</div>;
}
