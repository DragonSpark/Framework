@if (_identity is {} identity)
{
    @ChildContent(identity)
}
else
{
    @NotFoundTemplate
}

@code {
    uint? _identity;

    protected override void OnParametersSet()
    {
        _identity = uint.TryParse(Input, out var identity) ? identity : null;
        base.OnParametersSet();
    }

    [Parameter, EditorRequired]
    public required string Input { get; set; }

    [Parameter]
    public RenderFragment<uint> ChildContent { get; set; } = null!;

    [Parameter]
    public RenderFragment NotFoundTemplate { get; set; } = @<div>The identity could not be determined</div>;

}