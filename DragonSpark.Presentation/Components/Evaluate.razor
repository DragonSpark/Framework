@using DragonSpark.Presentation.Environment.Browser
@using DragonSpark.Application.Diagnostics
@using DragonSpark.Compose
@using DragonSpark.Application
@using DragonSpark.Model.Operations.Stop

@inherits ComponentBase

@inject IEvaluate Model

@code {
	IStopAware<string> _call = null!;

	protected override void OnInitialized()
	{
		var operation = new ExceptionAware<string>(Model, Exceptions, GetType());
		_call = operation.Then().Throttle(TimeSpan.FromMilliseconds(250)).Out();
		base.OnInitialized();
	}

	[Parameter]
	public RenderFragment? ChildContent { get; set; }

	[Parameter]
	public string Type { get; set; } = "text/javascript";

	[Parameter]
	public bool Force { get; set; }

	protected override bool ShouldRender() => Force;

	protected override Task OnAfterRenderAsync(bool firstRender)
	{
		if ((firstRender || Force) && Type == "text/javascript")
		{
			var script = ChildContent?.Text();
			if (!string.IsNullOrEmpty(script))
			{
				return _call.Allocate(new(script, Stop));
			}
		}
		return Task.CompletedTask;
	}
}