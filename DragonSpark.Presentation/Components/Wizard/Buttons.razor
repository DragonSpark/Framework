@using Microsoft.FluentUI.AspNetCore.Components

<div class="fluent-wizard-buttons" border-inside="@Border.HasFlag(WizardBorder.Inside)">
    @if (ButtonTemplate is not null)
    {
        @ButtonTemplate
    }
    else
    {
        <ButtonContainerComponent>
            @if (context.Previous is {} previous)
            {
                <FluentButton Appearance="ButtonAppearance.Default" OnClick="@previous.Action" Disabled="@context.Active">@previous.Text</FluentButton>
            }

            <span style="margin-right: 10px"></span>

            <FluentButton Appearance="@ButtonAppearance.Primary" OnClick="@context.Next.Action" Disabled="@context.Active">@context.Next.Text</FluentButton>
        </ButtonContainerComponent>
    }
</div>

@code {
    [Parameter]
    public WizardBorder Border { get; set; }

    [Parameter]
    public RenderFragment? ButtonTemplate { get; set; }
}