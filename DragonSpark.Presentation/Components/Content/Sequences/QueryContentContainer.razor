@typeparam T

@using DragonSpark.Application.AspNet.Entities.Queries.Runtime.Pagination

@inherits PagingContainer<T>

@code {

	public bool Wat => EnableClientCover && !_ready;

}

@inject IPaging<T> Paging

<DragonSpark.Presentation.Components.Content.ApplicationPrincipalAwareContentView>
    <DragonSpark.Presentation.Components.Rendering.GatedClientCover Enabled="@(Wat)">
        <PagingContentContainer T="T" @ref="_relay" Content="@_subject" ReportedType="@ReportedType" Results="@Results" HeaderTemplate="@HeaderTemplate" FooterTemplate="@FooterTemplate" ChildContent="@ChildContent" LoadingTemplate="@LoadingTemplate" EmptyElementsTemplate="@EmptyElementsTemplate" />
    </DragonSpark.Presentation.Components.Rendering.GatedClientCover>
</DragonSpark.Presentation.Components.Content.ApplicationPrincipalAwareContentView>