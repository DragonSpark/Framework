@using DragonSpark.Application.AspNet.Entities.Queries.Runtime.Pagination
@typeparam T
@inherits PagingContainerBase<T>

@inject IPaging<T> Paging

<ContentView TValue="IPages<T>" Content="@_subject" NotFoundTemplate="@NotFoundTemplate">
	@HeaderTemplate?.Invoke(new(_error, _state))
	
	@if (_error is not null)
	{
		@ExceptionTemplate(_error)
	}
	else
	{
		if (_state == QueryRenderState.Loading)
		{
			@LoadingTemplate
		}

		if (_state == QueryRenderState.Empty && EmptyElementsTemplate is not null)
		{
			@EmptyElementsTemplate
		}
		else
		{
			<CascadingValue TValue="IPageContainer<T>" Value="@this" IsFixed="true" ChildContent="@ChildContent(context)" />
		}
	}

	@FooterTemplate?.Invoke(new(_error, _state))
</ContentView>
@code {

	public IPages<T> Get(IPages<T> parameter) => Pagination?.Get(parameter) ?? parameter;

}
