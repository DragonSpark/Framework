@using DragonSpark.Compose
@using DragonSpark.Model.Results
@using DragonSpark.Presentation.Components.Content.Templates
@using System.Threading

@typeparam T

@inherits ContentComponentBase<T>

<ApplicationContentView TValue="T" Content="@Content" ChildContent="@ChildContent" NotFoundTemplate="@NotFoundTemplate" ForceRender="@ForceRender" />

@code {

    [Parameter]
    public required Func<CancellationToken, Task<T?>> Factory { get; set; }

    [Parameter]
    public required Switch? Refresh { get; set; }

    [Parameter]
    public required RenderFragment<T> ChildContent { get; set; }

    [Parameter]
    public virtual RenderFragment NotFoundTemplate { get; set; } = DefaultNotFoundTemplate.Default;

    [Parameter]
    public bool ForceRender { get; set; }

    protected override ValueTask<T?> GetContent() => Factory(Stop).ToOperation();

    protected override void OnParametersSet()
    {
        if (Refresh?.Down() == true)
        {
            RequestNewContent();
        }
        base.OnParametersSet();
    }

}