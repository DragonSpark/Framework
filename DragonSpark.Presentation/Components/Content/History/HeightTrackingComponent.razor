@using DragonSpark.Compose
@using DragonSpark.Presentation.Environment.Browser.Document
@using Microsoft.Extensions.Logging
@implements IAsyncDisposable

@inject ILogger<HeightTrackingComponent> Logger
@inject IJSRuntime Runtime
@inject NavigationManager Navigation
@inject RecentHeightTracker HeightTracker

<div @ref="_containerRef" class="application-content-wrapper">
	@ChildContent
</div>

@code {
	ElementReference    _containerRef;
	IDisposable?        _registration;
	IJSObjectReference? _module;

	[Parameter]
	public required RenderFragment? ChildContent { get; set; }
	
	protected override void OnInitialized()
	{
		_registration              =  Navigation.RegisterLocationChangingHandler(OnLocationChanging);
		Navigation.LocationChanged += NavigationOnLocationChanged;
	}

	async void NavigationOnLocationChanged(object? sender, LocationChangedEventArgs e)
	{
		try
		{
			if (_module is {} m && HeightTracker.TryPop(Navigation.Uri, out var entry) && entry is { } height and > 0)
			{
				await m.InvokeVoidAsync("setElementMinHeight", _containerRef, height).On();
				StateHasChanged();
			}
		}
		catch (Exception error)
		{
			Logger.LogWarning(error, "A problem was encountered while setting the minimal height of component");
		}
	}

	async ValueTask OnLocationChanging(LocationChangingContext context)
	{
		if (_module is {} m && await m.InvokeAsync<double>("getElementHeight", _containerRef).Off() is var height and > 0)
		{
			HeightTracker.Execute(new(Navigation.Uri, height));
		}
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			var reference = await Runtime.InvokeAsync<IJSObjectReference>("import", $"./{Assets.Path<HeightTrackingComponent>()}");
			_module = new PolicyAwareJSObjectReference(reference);
		}
	}

	public async ValueTask DisposeAsync()
	{
		Navigation.LocationChanged -= NavigationOnLocationChanged;

		if (_registration is IAsyncDisposable disposable)
		{
			await disposable.DisposeAsync().Off();
		}
		else
		{
			_registration?.Dispose();
		}

		if (_module is not null)
		{
			await _module.DisposeAsync().Off();
		}
	}
}