@typeparam TIn
@typeparam TOut

@inherits Templates.ActiveContentTemplateComponentBase<TOut>

@if (_exception is not null)
{
	@ExceptionTemplate
}
else
{
	if (!_ready && _view is not null)
	{
		@_view
	}
	<ContentView TValue="TOut" ChildContent="@ChildContent" Content="@_instance" NotFoundTemplate="@NotFoundTemplate" />
}

