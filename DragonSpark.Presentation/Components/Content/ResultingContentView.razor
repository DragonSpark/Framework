@typeparam T

@using DragonSpark.Presentation.Components.Content.History
@using DragonSpark.Presentation.Components.Content.Rendering

@inherits Templates.ActiveContentTemplateComponentBase<T>

@inject RenderStateStore Render

<RecentContentComponent @bind-Input="@_last" @bind-Input:after="Assign"></RecentContentComponent>

@if (_exception is {} exception)
{
	@ExceptionTemplate(exception)
}
else if (_fragment is {} fragment)
{
	@fragment
}
else
{
	@LoadingTemplate
}