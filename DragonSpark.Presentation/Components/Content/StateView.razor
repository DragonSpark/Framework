@typeparam T

@using DragonSpark.Compose
@using DragonSpark.Model.Results
@using DragonSpark.Presentation.Components.Content.History

@inherits StateViewBase<T>

<RecentContentComponent @bind-Input="@_content" />

@if (_content is {} content)
{
	<VersionedComponent Version="@_version">@ChildContent(content)</VersionedComponent>
}
else
{
	@LoadingTemplate
}

@code
{
	uint _version;
	T?   _content;

	[Parameter]
	public EventCallback<IMutable<T?>> Ready { get; set; }

	[Parameter]
	public Switch? Refresh { get; set; }

	[Parameter]
	public IEqualityComparer<T> Comparer { get; set; } = EqualityComparer<T>.Default;

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if ((firstRender || Refresh?.Down() == true) && await RefreshContent().On())
		{
			_version++;
			StateHasChanged();
		}
	}

	async Task<bool> RefreshContent()
	{
		var previous = _content;
		var current  = await Definition.On();
		var content = await ComposeContent(current.Success ? current.Value : New.Get()).Off();
		var result = !Comparer.Equals(previous, content);
		if (result)
		{
			_content = content;
		}
		return result;
	}

	async Task<T?> ComposeContent(T? parameter)
	{
		if (Ready.HasDelegate)
		{
			var store = new Variable<T>(parameter);
			await Ready.Off(store);
			return store.Get();
		}

		return parameter;
	}
}