@using DragonSpark.Presentation.Environment.Browser
@using DragonSpark.Compose
@using DragonSpark.Model.Results
@using DragonSpark.Presentation.Components.Content.History
@using DragonSpark.Presentation.Components.Content.Rendering
@using DragonSpark.Presentation.Components.Content.Templates
@using DragonSpark.Presentation.Components.Interaction

@implements IDisposable

@inject RecentContentTracker<T?> Recent
@inject RenderStateStore Render

@typeparam T

@if (_binding is not null)
{
	@ChildContent(_binding)
}
else
{
	@LoadingTemplate
}


@code
{
	readonly Switch   _requested = new();
	Binding<T>?       _binding;
	ComponentEntryKey _key;

	protected override async Task OnInitializedAsync()
	{
		if (Recent.TryPop(new(this, Scope?.Scope ?? Qualifier), out var entry) && entry.Content is {} content)
		{
			_binding = new(content, RequestUpdate, Comparer);			
		}

		_key = entry.Key;

		if (Render >= RenderState.Connected)
		{
			var value = await DetermineValue().On();
			_binding ??= new(value, RequestUpdate, Comparer);
			_binding.Execute(value);
			await Update(value).Off();
		}
		
	}
	[Parameter]
	public string Qualifier { get; set; } = string.Empty;

	[Parameter]
	public required IClientVariable<T> Store { get; set; }

	[Parameter]
	public required T Value { get; set; }

	[Parameter]
	public Func<T>? AssignedValue { get; set; }

	[Parameter]
	public EventCallback<T> ValueChanged { get; set; }

	[Parameter]
	public EventCallback<Binding<T>> Loaded { get; set; }

	[Parameter]
	public IEqualityComparer<T> Comparer { get; set; } = EqualityComparer<T>.Default;

	[Parameter]
	public RenderFragment<Binding<T>> ChildContent { get; set; } = null!;

	[Parameter]
	public RenderFragment LoadingTemplate { get; set; } = MinimalLoadingTemplate.Default;

	[CascadingParameter] ContentScope? Scope { get; set; }
	
	void RequestUpdate(T parameter)
	{
		if (_requested.Up())
		{
			StateHasChanged();
		}
	}

	protected override async Task OnParametersSetAsync()
	{
		if (_requested.Down() && _binding is {} binding)
		{
			await Update(binding.Value).On();
			await Store.Off(binding.Value);
		}
	}

	async ValueTask<T> DetermineValue()
	{
		var result = await Store.Off();
		return result.Success
			       ? result.Value ?? (AssignedValue is not null ? AssignedValue() : Value)
			       : AssignedValue is not null
				       ? AssignedValue() : Value;
	}

	async Task<bool> Update(T parameter)
	{
		var same = Comparer.Equals(Value, parameter);
		if (!same)
		{
			if (ValueChanged.HasDelegate)
			{
				await ValueChanged.Off(Value = parameter);
			}
			else
			{
				return true;
			}
		}
		return false;
	}

	public void Dispose()
	{
		Recent.Execute(_key, _binding is {} b ? b.Value : default);
	}
}