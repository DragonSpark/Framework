@inherits RadzenComponent

@using DragonSpark.Compose
@using DragonSpark.Application.Diagnostics
@using DragonSpark.Presentation.Components.Runtime

@inject DialogService Dialogs
@inject IExceptions Exceptions

<DragonSpark.Presentation.Components.Dialogs.DefaultEscapeContainer Escaped="@(() => Cancel.Invoke(null!))" EnableFocus="@EnableFocus">
	<ActivityReceiverContainer Context="receiver">
		<ParameterMonitorComponent T="IActivityReceiver" Subject="@receiver" SubjectChanged="@OnChanged" />
		<div class="card">
			<div class="@ContentClass">@ChildContent</div>
			<div class="card-footer">
				@if (PreButtonTemplate is not null)
				{
					@PreButtonTemplate
				}
				<div class="d-flex justify-content-between" style="gap: 20px">
					<ButtonComponent Text="@SecondaryText" Click="OnCancel" ButtonStyle="ButtonStyle.Secondary"
					                 class="@SecondaryClass"/>

					<ButtonComponent Disabled="@(!EnablePrimary)" Text="@PrimaryText" Click="@_click" class="@PrimaryClass"/>
				</div>
			</div>
		</div>
	</ActivityReceiverContainer>
</DragonSpark.Presentation.Components.Dialogs.DefaultEscapeContainer>

@code
{
	EventCallback<MouseEventArgs> _click;

	protected override Task OnInitializedAsync() => Opened.Invoke();

	void OnChanged(IActivityReceiver? parameter)
	{
		_click = parameter is not null ?
			         Start.A.Callback<MouseEventArgs>(OnAccept)
			              .Handle(Exceptions, ReportedType ?? GetType())
			              .UpdateActivity(parameter)
			              .DurationBlock()
			         : null!;
	}


	async Task OnAccept(MouseEventArgs parameter)
	{
		if (await Confirmation())
		{
			await Accept.On(parameter);
			Dialogs.Close();
		}
	}

	async Task OnCancel(MouseEventArgs parameter)
	{
		await Cancel.Invoke(parameter);
		Dialogs.Close();
	}

	[Parameter]
	public bool EnableFocus { get; set; } = true;

	[Parameter]
	public bool EnablePrimary { get; set; } = true;

	[Parameter]
	public string PrimaryText { get; set; } = "OK";

	[Parameter]
	public string SecondaryText { get; set; } = "Cancel";

	[Parameter]
	public string ContentClass { get; set; } = "ds-dialog-content card-body";

	[Parameter]
	public string PrimaryClass { get; set; } = null!;

	[Parameter]
	public string SecondaryClass { get; set; } = null!;

	[Parameter]
	public Func<ValueTask<bool>> Confirmation { get; set; } = () => true.ToOperation();

	[Parameter]
	public RenderFragment ChildContent { get; set; } = null!;

	[Parameter]
	public EventCallback Opened { get; set; }

	[Parameter]
	public EventCallback<MouseEventArgs> Accept { get; set; }

	[Parameter]
	public EventCallback<MouseEventArgs> Cancel { get; set; }

	[Parameter]
	public RenderFragment? PreButtonTemplate { get; set; }

	[Parameter]
	public Type? ReportedType { get; set; }
}