@using DragonSpark.Compose
@using DragonSpark.Model.Results
@using DragonSpark.Presentation.Components.Forms.Validation

@inherits InteractiveComponentBase

<CascadingValue IsFixed="true" Value="@_monitor" ChildContent="@ChildContent(_submit)"/>

@code {
    readonly HashSet<EventCallback<SubmittingInput>> _store = [];
    EventCallback<EditContext>                       _submit;
    SubmissionMonitor                                _monitor = null!;

    protected override void OnInitialized()
    {
        _submit  = Start.A.Callback(Submit).UpdateActivity(Receiver).Handle(Exceptions);
        _monitor = new(_submit, Allowed, _store);
        base.OnInitialized();
    }

    [Parameter]
    public required RenderFragment<EventCallback<EditContext>> ChildContent { get; set; }

    [Parameter, EditorRequired]
    public Switch? Allowed { get; set; }

    [Parameter]
    public EventCallback<SubmittingInput> Submitting { get; set; }

    [Parameter]
    public EventCallback<EditContext> Submitted { get; set; }

    [Parameter]
    public EventCallback Completed { get; set; }

    async Task Submit(EditContext parameter)
    {
        var submitting = new SubmittingInput(parameter);
        try
        {
            if (await Continue(submitting).On())
            {
                await Submitted.On(parameter);
                await Completed.Off();
            }
            else
            {
                parameter.MarkModified();
            }
        }
        catch
        {
            submitting.Cancel.Up();
            parameter.MarkModified();
            throw;
        }
    }

    async Task<bool> Continue(SubmittingInput parameter)
    {
        foreach (var callback in _store.Prepend(Submitting))
        {
            await callback.On(parameter);
            if (parameter.Cancel)
            {
                return false;
            }
        }

        return true;
    }

}