@typeparam T where T : class
@using DragonSpark.Compose
@using DragonSpark.Model.Results
@using DragonSpark.Model.Selection.Conditions
@using DragonSpark.Model.Sequences
@using DragonSpark.Presentation.Components.Eventing

@inherits ModelPersistenceComponentBase<T>
@implements IAsyncDisposable

@inject IPublisher<SaveModelMessage> Save

<DragonSpark.Presentation.Components.Runtime.PauseEventComponent Updated="@_update" />

@code {
	readonly Switch _save  = false;
	Array<string>   _skip  = Array<string>.Empty;
	T               _model = null!;
	EditContext?    _context;
	EventCallback   _update;

	protected override void OnInitialized()
	{
		_update = Start.A.Callback(Commit).Hide();
		base.OnInitialized();
	}

	protected override void OnParametersSet()
	{
		var context = ResolvedContext;
		if (_context != context)
		{
			if (_context is not null)
			{
				_context.OnFieldChanged -= FieldChanged;
			}

			if ((_context = context) != null)
			{
				_context.OnFieldChanged += FieldChanged;
				_model = Model ?? _context.Model.To<T>();
			}
		}

		base.OnParametersSet();
	}

	[Parameter]
	public T? Model { get; set; }

	EditContext ResolvedContext
		=> (EditContext ?? ParentEditContext).Verify($"Edit Context is required for {GetType().Name}");

	[Parameter]
	public bool Enabled { get; set; } = true;

	[Parameter]
	public EditContext? EditContext { get; set; }

	[Parameter]
	public ICondition<FieldIdentifier>? Condition { get; set; }

	[Parameter]
	public required string FieldsToSkip
	{
		get;
		set
		{
			if (field != value)
			{
				field = value;
				_skip = field.Split(',', StringSplitOptions.RemoveEmptyEntries);
			}
		}
	}

	[CascadingParameter] EditContext? ParentEditContext { get; set; }

	void FieldChanged(object? sender, FieldChangedEventArgs args)
	{
		var identifier = args.FieldIdentifier;
		if (Enabled && (Condition?.Get(identifier) ?? true)
		            && !_skip.Open().Contains(identifier.FieldName) && _save.Up())
		{
			StateHasChanged();
		}
	}

	protected override Task OnAfterRenderAsync(bool firstRender) => Commit().AsTask();

	public ValueTask DisposeAsync()
	{
		_context?.OnFieldChanged -= FieldChanged;
		return Commit();
	}

	ValueTask Commit() => _save.Down() ? Save.Get(new(_model)) : ValueTask.CompletedTask;

}