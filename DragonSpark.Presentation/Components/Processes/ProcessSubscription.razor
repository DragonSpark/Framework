@using DragonSpark.Application.Connections.Events
@using DragonSpark.Contracts.Worker

@inherits InteractiveComponentBase<Guid>

@if (Status is not ProcessStatus.Completed)
{
	<DragonSpark.Presentation.Components.State.IdentitySubscriptionComponent T="Guid" Input="@Input" Updated="@Updated" Registration="@Registration" />
}

@code {

	[Parameter, EditorRequired]
	public required ProcessStatus Status { get; set; }

	[Parameter, EditorRequired]
	public required ISubscribe<Guid> Registration { get; set; }
}
