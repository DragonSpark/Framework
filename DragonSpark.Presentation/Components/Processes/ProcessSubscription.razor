@using DragonSpark.Application.Connections.Events
@using DragonSpark.Compose
@using DragonSpark.Contracts.Worker
@using DragonSpark.Model.Operations.Selection.Conditions

@inherits InteractiveComponentBase<Guid>

@if (Status is not ProcessStatus.Completed)
{
	<DragonSpark.Presentation.Components.Content.Rendering.ConnectedStateAwareComponent>
		<FilteredSubscribeComponent T="Guid" Registration="@Registration" Condition="@_filter" Received="@Updated" />
	</DragonSpark.Presentation.Components.Content.Rendering.ConnectedStateAwareComponent>
}

@code {
	IDepending<Guid> _filter = null!;

	protected override void OnInitialized()
	{
		_filter = Is.EqualTo(Input).Operation().Out();
		base.OnInitialized();
	}

	[Parameter, EditorRequired]
	public required ProcessStatus Status { get; set; }

	[Parameter, EditorRequired]
	public required ISubscribe<Guid> Registration { get; set; }
}
