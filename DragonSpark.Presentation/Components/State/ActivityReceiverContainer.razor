@if (_instance is not null)
{
	@ChildContent(_instance)
}
else
{
	<ActivityContainer CssClass="@CssClass" ChildContent="@ChildContent" />
}

@code {
	IActivityReceiver? _instance;

	protected override void OnInitialized()
	{
		_instance = (Instance == EmptyActivityReceiver.Default ? null : Instance) ?? Receiver;
		base.OnInitialized();
	}

	[Parameter]
	public IActivityReceiver? Instance { get; set; }

	[Parameter]
	public string CssClass { get; set; } = string.Empty;

    [CascadingParameter] IActivityReceiver? Receiver { get; set; }

    [Parameter]
    public RenderFragment<IActivityReceiver> ChildContent { get; set; } = null!;
}
