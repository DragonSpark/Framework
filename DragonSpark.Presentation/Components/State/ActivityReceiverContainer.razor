@using DragonSpark.Compose
@switch (_action)
{
	case ActivityReceiverContextAction.New:
		<ActivityContainer CssClass="@CssClass" ChildContent="@ChildContent" />
		break;
	case ActivityReceiverContextAction.Existing:
		@ChildContent(Receiver.Verify())
		break;
	case ActivityReceiverContextAction.Clear:
		<ActivityContainer CssClass="@CssClass">
			<CascadingValue TValue="IActivityReceiver" Value="null" ChildContent="@ChildContent(EmptyActivityReceiver.Default)" />
		</ActivityContainer>
		break;
}

@code {

	ActivityReceiverContextAction _action;

	protected override void OnParametersSet()
	{
		_action = Action == ActivityReceiverContextAction.Existing && Receiver is null ? ActivityReceiverContextAction.New : Action;
		base.OnParametersSet();
	}

	[Parameter]
	public required ActivityReceiverContextAction Action { get; set; } = ActivityReceiverContextAction.Existing;

	[Parameter]
	public string CssClass { get; set; } = string.Empty;

	[Parameter]
	public RenderFragment<IActivityReceiver> ChildContent { get; set; } = null!;

	[CascadingParameter] IActivityReceiver? Receiver { get; set; }
}
