@using DragonSpark.Compose
@using DragonSpark.Presentation.Compose
@inherits EventCallbackContainerBase

@typeparam T

@ChildContent(_subject)

@code {
	EventCallback<T> _subject;

	[Parameter, EditorRequired]
	public required RenderFragment<EventCallback<T>> ChildContent { get; set; }

	[Parameter, EditorRequired]
	public EventCallback<T> Subject { get; set; }

	protected override bool HasChanged(ParameterView parameters)
		=> parameters.DidParameterChange(nameof(Subject), Subject) || base.HasChanged(parameters);

	protected override Task Changed()
	{
		_subject = Create();
		return Task.CompletedTask;
	}

	OperationCallbackComposer<T> Create()
	{
		var start = Start.A.Callback(Subject, PreserveNotificationOwner ? Owner : null);
		var next   = StopHandle is {} handle ? start.UpdateActivity(Receiver, new(StopMessage, handle, Canceled: Stopped)) : start.UpdateActivity(Receiver);
		var result = next.Handle(Exceptions, Owner.GetType());
		return result;
	}

}
