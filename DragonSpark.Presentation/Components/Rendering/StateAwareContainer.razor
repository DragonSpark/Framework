@using DragonSpark.Compose
<DragonSpark.Presentation.Components.Content.Rendering.ConnectedStateAwareComponent>
	<DragonSpark.Presentation.Components.Eventing.HandlerView T="UpdateStateMessage" Received="@_received" />
</DragonSpark.Presentation.Components.Content.Rendering.ConnectedStateAwareComponent>

@ChildContent

@code {
	EventCallback<UpdateStateMessage> _received;
	protected override void OnInitialized()
	{
		_received = Start.A.Callback<UpdateStateMessage>(OnReceived).Hide();
		base.OnInitialized();
	}

	[Parameter]
	public RenderFragment ChildContent { get; set; } = null!;

	[Parameter]
	public object? Subject { get; set; }

	void OnReceived(UpdateStateMessage parameter)
	{
		if (parameter.Subject == Subject)
		{
			StateHasChanged();
		}
	}
}