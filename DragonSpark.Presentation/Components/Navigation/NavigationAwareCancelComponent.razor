@using DragonSpark.Presentation.Components.Content.Rendering
@using DragonSpark.Presentation.Runtime.Operations
@using System.Threading

@inject IRequestToken Token
@inject IRenderState Render
@implements IDisposable

<CascadingValue IsFixed="true" Value="@_combined.Token" ChildContent="@ChildContent"/>

@code {
    readonly CancellationTokenSource _source   = new();
    CancellationTokenSource          _combined = null!;

    [Parameter]
    public required RenderFragment? ChildContent { get; set; }

    protected override void OnInitialized()
    {
        var token     = Token.Get();
        var connected = Render.IsConnected();
        var other     = connected ? _source.Token : CancellationToken.None;
        _combined = CancellationTokenSource.CreateLinkedTokenSource(token, other);
        base.OnInitialized();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);
    }

    public void Dispose()
    {
        _source.Cancel();
        _source.Dispose();
    }

}