@using DragonSpark.Presentation.Runtime.Operations
@using System.Threading
@implements IDisposable

@inject IRequestToken Token

<CascadingValue Value="@(_combined?.Token ?? CancellationToken.None)" ChildContent="@ChildContent"/>

@code {
	CancellationTokenSource  _source = new();
	CancellationTokenSource? _combined;

	[Parameter]
	public required RenderFragment? ChildContent { get; set; }

	public override Task SetParametersAsync(ParameterView parameters)
	{
		var result = base.SetParametersAsync(parameters);

		_source.Cancel();
		CreateNewTokens();

		return result;
	}

	void CreateNewTokens()
	{
		_source.Dispose();
		_source = new();
		var token = Token.Get();
		_combined?.Dispose();
		_combined = CancellationTokenSource.CreateLinkedTokenSource(token, _source.Token);
	}

	public void Dispose()
	{
		_source.Cancel();
		_combined?.Dispose();
		_source?.Dispose();
	}
}