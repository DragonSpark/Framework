@using DragonSpark.Compose
@using DragonSpark.Application
@using DragonSpark.Application.AspNet.Security.Identity
@using DragonSpark.Application.AspNet.Security.Identity.Authentication
@using DragonSpark.Application.AspNet.Security.Identity.Model

@typeparam T where T : IdentityUser

@inject IValidationServices Validation
@inject AuthenticationStore Set
@inject IRedirectToSignOut SignOut
@inject IAssignProfileStatus Assign

@if (_scene is not null)
{
    <CascadingValue TValue="ProfileStatus" Value="@_status" ChildContent="@_scene" />
}

@code
{
    AuthenticationState<T>? _current;
    ProfileStatus           _status;
    RenderFragment?         _scene;

    protected override async Task OnInitializedAsync()
    {
        var current = await State.On();
        var valid = await Validation.Get(current.User).On();
        if (!valid)
        {
            Set.Execute(AuthenticationState<T>.Default);
            SignOut.Execute();
        }
    }

    [Parameter]
    public required RenderFragment<AuthenticationState<T>> ChildContent { get; set; }

    [CascadingParameter]
    public required Task<AuthenticationState> State { get; set; }

    public override async Task SetParametersAsync(ParameterView parameters)
    {
        var changed  = parameters.DidParameterChange(nameof(State), State);
        await base.SetParametersAsync(parameters).On();
        if (changed)
        {
            var state = await State.On();
            if (state != _current && state is AuthenticationState<T> next
                                  && (_current is null
                                      || _current.User.IsAuthenticated() != state.User.IsAuthenticated()
                                      || _current.Profile?.SecurityStamp != next.Profile?.SecurityStamp))
            {
                _current = next;
                _scene   = ChildContent(_current);
                _status  = GetProfileStatus.Default.Get(_current);
                Assign.Execute(_status);
            }
        }
    }
}