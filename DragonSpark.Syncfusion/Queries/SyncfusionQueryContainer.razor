@using DragonSpark.Application.AspNet.Entities.Queries.Runtime
@using DragonSpark.Application.AspNet.Entities.Queries.Runtime.Shape
@using DragonSpark.Application.Runtime.Operations
@using DragonSpark.Presentation.Components.Content.Sequences
@using DragonSpark.Presentation.Components.Content.Templates

@typeparam T

@inherits ManyActiveContentTemplateComponentBase<IDataRequest>

<QueryContentContainer
	Content="@Content"
	Compose="@Compose"
	LoadingTemplate="@EmptyContentTemplate.Default"
	EnableClientCover="@EnableClientCover"
	EmptyElementsTemplate="@EmptyElementsTemplate"
	HeaderTemplate="@HeaderTemplate"
	FooterTemplate="@FooterTemplate"
	NotFoundTemplate="@NotFoundTemplate"
	ExceptionTemplate="@ExceptionTemplate"
	ReportedType="@ReportedType"
>
	<SyncfusionPagingContainer
		Content="@context"
		Reporter="@Reporter"
		ChildContent="@ChildContent"
		LoadingTemplate="@EmptyContentTemplate.Default"
		ExceptionTemplate="@ExceptionTemplate"
		NotFoundTemplate="@NotFoundTemplate"
	/>
</QueryContentContainer>

@code {
	[Parameter]
	public required bool EnableClientCover { get; set; } = true;

	[Parameter]
	public IQueries<T>? Content { get; set; }

	[Parameter]
	public ICompose<T> Compose { get; set; } = SyncfusionCompose<T>.Default;

	[Parameter]
	public IReporter<IDataRequest> Reporter { get; set; } = Queries.Reporter.Default;

	[Parameter]
	public Type? ReportedType { get; set; }

	[Parameter]
	public RenderFragment<PagingRenderState>? HeaderTemplate { get; set; }

	[Parameter]
	public RenderFragment<PagingRenderState>? FooterTemplate { get; set; }
}