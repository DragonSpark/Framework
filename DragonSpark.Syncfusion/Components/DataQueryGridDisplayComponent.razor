@typeparam T
@using DragonSpark.Compose
@using DragonSpark.Presentation.Components
@using DragonSpark.SyncfusionRendering.Queries
@using Radzen
@inherits DataGridTemplateComponentBase<T>

@if (_identity is not null)
{
    if (BodyHeaderTemplate is not null)
    {
        @BodyHeaderTemplate
    }
    <DragonSpark.SyncfusionRendering.Components.DataRequestGateContainer Input="Input" Store="@_store" Context="input">
        <DataQueryGrid T="T" Content="@input"
                       Identifier="@_identity"
                       FilterType="@FilterType"
                       ReportedType="@ReportedType"
                       Columns="@Columns"
                       AllowSelection="@AllowSelection"
                       AllowPaging="@AllowPaging"
                       AllowFiltering="@AllowFiltering"
                       AllowSorting="@AllowSorting"
                       AllowExport="@AllowExport"
                       LoadingTemplate="@LoadingTemplate"
                       DesktopToolbar="@DesktopToolbar"
                       MobileToolbar="@MobileToolbar"
                       CssClass="@CssClass"
                       Breakpoint="@Breakpoint"
                       PageSize="@PageSize"
                       Editing="@Editing"
                       Created="@Created"
                       Updated="@Updated"
					   Empty="@_clear"
					   Ready="@_clear"
					   Error="@_clear"
                       @attributes="@AdditionalAttributes">
            @if (BodyContentTemplate is not null)
            {
                @BodyContentTemplate
            }
        </DataQueryGrid>
    </DragonSpark.SyncfusionRendering.Components.DataRequestGateContainer>

    if (BodyFooterTemplate is not null)
    {
        @BodyFooterTemplate
    }
}
else
{
    @LoadingTemplate
}

@code {
	readonly IDataResults _store = new DataResults();
	string?               _identity;
	Action                _clear = null!;

	protected override void OnInitialized()
	{
		_clear = Clear;
		base.OnInitialized();
	}

	[Parameter]
    public required IDataRequest Input { get; set; }

    public override async Task SetParametersAsync(ParameterView parameters)
    {
        var update = parameters.DidParameterChange(nameof(Id), Id) || parameters.DidParameterChange(nameof(Qualifier), Qualifier);
        await base.SetParametersAsync(parameters).Off();
        if (update)
        {
            _identity = $"{GenerateElementIdentifier.Default.Get(Id)}{Qualifier}";
        }
    }

    void Clear()
    {
	    _store.Execute();
    }
}